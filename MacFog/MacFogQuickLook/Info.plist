<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MacFog Quick Look</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>QLSupportedContentTypes</key>
			<array>
				<!-- Machine Learning Models -->
				<string>com.apple.core-ml.mlmodel</string>
				<string>com.apple.core-ml.mlpackage</string>
				<string>org.huggingface.safetensors</string>
				<string>com.tensorflow.checkpoint</string>
				<string>com.pytorch.model</string>
				<string>org.onnx.model</string>
				
				<!-- Developer Files -->
				<string>public.folder</string>
				<string>public.directory</string>
				<string>public.data</string>
				<string>public.content</string>
				
				<!-- Binary/Model Files -->
				<string>public.binary</string>
				<string>public.data</string>
				
				<!-- Cache Directories -->
				<string>com.apple.application-cache</string>
			</array>
			<key>QLSupportsSearchableItems</key>
			<false/>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.quicklook.preview</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).QuickLookPreviewController</string>
	</dict>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<!-- HuggingFace Safetensors -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>HuggingFace Safetensors Model</string>
			<key>UTTypeIdentifier</key>
			<string>org.huggingface.safetensors</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>safetensors</string>
				</array>
			</dict>
		</dict>
		
		<!-- TensorFlow Checkpoint -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>TensorFlow Model Checkpoint</string>
			<key>UTTypeIdentifier</key>
			<string>com.tensorflow.checkpoint</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ckpt</string>
					<string>bin</string>
					<string>index</string>
				</array>
			</dict>
		</dict>
		
		<!-- PyTorch Model -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>PyTorch Model</string>
			<key>UTTypeIdentifier</key>
			<string>com.pytorch.model</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pt</string>
					<string>pth</string>
					<string>bin</string>
				</array>
			</dict>
		</dict>
		
		<!-- ONNX Model -->
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>ONNX Model</string>
			<key>UTTypeIdentifier</key>
			<string>org.onnx.model</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>onnx</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
